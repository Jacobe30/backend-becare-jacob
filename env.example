PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string
CHAT_ENABLED=1
# Comma-separated allowed browser origins (customer site + admin dashboard).
# Both the REST API and Socket.IO use this list. Use * only for local dev.
CORS_ORIGINS=https://gosuksa-tmin.lovable.app,https://admin-companion-88.lovable.app
# Set to 1 to require "Authorization: Bearer $ADMIN_TOKEN" on /users
ADMIN_LIST_PROTECTED=0
# VIC (vehicle-info-main) options for local/dev
# Real vehicle-info provider endpoint (leave unset to record vehicle_not_found)
VIC_UPSTREAM_URL=
VIC_UPSTREAM_TOKEN=
# Persist submissions across redeploys (mount a Railway volume at /data)
DATA_FILE=/data/data.json

# Firestore persistence for the external admin dashboard.
# Option A: paste the complete Firebase service-account JSON as one Railway variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: use Google Application Default Credentials and set the project ID.
FIREBASE_PROJECT_ID=
# Set to 1 only for local development when Firestore is intentionally unavailable.
FIRESTORE_DISABLED=0
